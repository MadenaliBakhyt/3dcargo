# Only needed if your backend runs somewhere other than http://localhost:8000
# during `npm run dev`. The browser never talks to this directly -- it always
# calls this app's own origin, and the Next.js dev server proxies /api/* here.
# BACKEND_INTERNAL_URL=http://localhost:8000

# Only set this if the *browser* must call the backend directly at a
# different origin than this app (e.g. no server-side proxying available).
# Leave commented out for the normal case.
# NEXT_PUBLIC_API_URL=http://localhost:8000
