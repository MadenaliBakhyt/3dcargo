# Copy to .env and adjust if the default host ports (3000, 8000) are already
# in use on your server. Used by docker-compose.yml. These only remap the
# HOST ports Docker publishes -- the frontend and backend containers still
# find each other correctly over Docker's internal network regardless.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Only set this if the *browser* must call the backend directly at a
# different origin than this app -- normally not needed, since the frontend
# proxies /api/* to the backend server-side. See README.
# NEXT_PUBLIC_API_URL=http://localhost:8000
