# Copy to .env and adjust if the default ports (3000, 8000) are already in use
# on your server. Used by docker-compose.yml.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Only needed if the frontend must reach the backend at a different host/port
# than "localhost:${BACKEND_PORT}" from the browser's point of view (e.g. a
# reverse proxy or a public domain) -- overrides the BACKEND_PORT-derived default.
# NEXT_PUBLIC_API_URL=http://localhost:8000
